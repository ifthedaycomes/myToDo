generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Goal {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  weeklyPlans WeeklyPlan[]
  todos       Todo[]
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  githubId  String    @unique
  username  String
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  todos     Todo[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WeeklyPlan {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  weekStart     DateTime      @unique
  memo          String?
  retrospective String?
  goalId        String?       @db.ObjectId
  goal          Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  weeklyGoals   WeeklyGoal[]
  todos         Todo[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model WeeklyGoal {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  text         String
  done         Boolean    @default(false)
  order        Int        @default(0)
  weeklyPlanId String     @db.ObjectId
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
}

enum TodoStatus {
  todo
  doing
  done
}

enum TodoPriority {
  low
  medium
  high
}

model Todo {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  status       TodoStatus   @default(todo)
  priority     TodoPriority @default(medium)
  dueDate      DateTime?
  dayOfWeek    Int?
  order        String
  weeklyPlanId String?      @db.ObjectId
  weeklyPlan   WeeklyPlan?  @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)
  goalId       String?      @db.ObjectId
  goal         Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, status, order])
}
